# PanchayatMausam AI Backend Configuration

APP_NAME="PanchayatMausam AI Backend"
APP_VERSION="1.0.0"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration (SQLite for local demo / PostgreSQL with PostGIS for production)
DATABASE_URL="sqlite:///./panchayatmausam.db"
# Example PostgreSQL/PostGIS:
# DATABASE_URL="postgresql://panchayat_user:panchayat_pass@localhost:5432/panchayatmausam_db"

# JWT Security
SECRET_KEY="panchayatmausam-super-secret-production-key-change-in-env"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000"
