# =================================================================
# PanchayatMausam AI (पंचायत मौसम AI) — Environment Configuration Template
# =================================================================

# -----------------------------------------------------------------
# 1. Server & Runtime Environment
# -----------------------------------------------------------------
ENVIRONMENT=development               # 'development', 'staging', 'production'
PORT=8000
DEBUG=true

# -----------------------------------------------------------------
# 2. Database Connection
# -----------------------------------------------------------------
# Option A: Local SQLite database (Default zero-config setup)
DATABASE_URL=sqlite:///./panchayatmausam.db

# Option B: Production PostgreSQL with PostGIS extension (Docker/Cloud)
# DATABASE_URL=postgresql://postgres:postgres_secure_2026@localhost:5432/panchayatmausam

# -----------------------------------------------------------------
# 3. Security & JWT Authentication
# -----------------------------------------------------------------
SECRET_KEY=change-this-to-a-random-secure-secret-key-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080     # 7 days token validity

# -----------------------------------------------------------------
# 4. CORS Allowed Origins (Comma-separated list)
# -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80,*

# -----------------------------------------------------------------
# 5. Frontend API Connectivity (Vite)
# -----------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_USE_BACKEND_API=true

# -----------------------------------------------------------------
# 6. Weather Ingestion Pipeline
# -----------------------------------------------------------------
WEATHER_API_PROVIDER=open-meteo
WEATHER_INGESTION_INTERVAL_HOURS=1
WEATHER_PROVISIONAL_GRIDDED_FLAG=true
